# Copy to .env and replace these placeholders locally. Never commit real credentials.
FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# Leave DATABASE_URL empty to use SQLite in instance/renta_sprinter.db.
DATABASE_URL=
# Example for MySQL (replace username/password with your own):
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/renta_sprinter?charset=utf8mb4

# Optional SMTP settings; not used until email notifications are implemented.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
